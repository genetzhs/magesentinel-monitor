msgid_plural "MageSentinel has watched your checkout through %d test purchases."
msgstr[0] "Το MageSentinel έχει ελέγξει το checkout σου με %d δοκιμαστική αγορά."
msgstr[1] "Το MageSentinel έχει ελέγξει το checkout σου με %d δοκιμαστικές αγορές."

msgid "MageSentinel has been watching your store for two weeks."
msgstr "Το MageSentinel παρακολουθεί το κατάστημά σου εδώ και δύο εβδομάδες."

msgid "If it is useful to you, a short review on WordPress.org helps other store owners find it. It takes a minute."
msgstr "Αν σου είναι χρήσιμο, μια σύντομη κριτική στο WordPress.org βοηθάει κι άλλους ιδιοκτήτες καταστημάτων να το βρουν. Παίρνει ένα λεπτό."

msgid "Write a review"
msgstr "Γράψε κριτική"

msgid "Later"
msgstr "Αργότερα"

msgid "No, thanks"
msgstr "Όχι, ευχαριστώ"

msgid "Match my system"
msgstr "Όπως το σύστημά μου"

msgid "Light"
msgstr "Φωτεινό"

msgid "Dark"
msgstr "Σκούρο"

msgid "Colours"
msgstr "Χρώματα"

msgid "DNS on this server"
msgstr "DNS σε αυτόν τον server"

msgid "No nameserver in /etc/resolv.conf answers: this site cannot reach payment gateways, couriers or updates. Ask your host."
msgstr "Κανένας nameserver στο /etc/resolv.conf δεν απαντά: το site δεν μπορεί να φτάσει σε τράπεζες, courier ή ενημερώσεις. Ενημερώστε τον πάροχο φιλοξενίας."

msgid "Lookups take %1$s s: the first nameserver in /etc/resolv.conf (%2$s) does not answer, so every lookup waits %3$s s before trying the next. Remove it or move it down, or ask your host."
msgstr "Η αναζήτηση διευθύνσεων κάνει %1$s s: ο πρώτος nameserver στο /etc/resolv.conf (%2$s) δεν απαντά, οπότε κάθε αναζήτηση περιμένει %3$s s πριν δοκιμάσει τον επόμενο. Αφαιρέστε τον ή μετακινήστε τον πιο κάτω, ή ενημερώστε τον πάροχο φιλοξενίας."

msgid "Lookups answer in %s ms."
msgstr "Οι αναζητήσεις απαντούν σε %s ms."

msgid "Want an email the next time this happens? MageSentinel runs this check every hour. 14 days free, no card."
msgstr "Θέλετε email την επόμενη φορά που θα συμβεί; Το MageSentinel κάνει αυτόν τον έλεγχο κάθε ώρα. 14 ημέρες δωρεάν, χωρίς κάρτα."

msgid "Start the free trial"
msgstr "Ξεκινήστε τη δωρεάν δοκιμή"

msgid "Free plan: connector inactive"
msgstr "Πλάνο Free: ο connector είναι ανενεργός"

msgid "MageSentinel still checks your checkout once a day, without test orders or store diagnostics. The plugin can stay installed. Choose a plan for checks every 30 minutes."
msgstr "Το MageSentinel συνεχίζει να ελέγχει το checkout μία φορά τη μέρα, χωρίς δοκιμαστικές παραγγελίες και διαγνωστικά του καταστήματος. Το plugin μπορεί να μείνει εγκατεστημένο. Επιλέξτε πλάνο για ελέγχους κάθε 30 λεπτά."

msgid "Taking orders"
msgstr "Λήψη παραγγελιών"

msgid "Security"
msgstr "Ασφάλεια"

msgid "Platform"
msgstr "Πλατφόρμα"

msgid "slow"
msgstr "αργό"

msgid "slower than usual"
msgstr "πιο αργό από συνήθως"

msgid "Scale %s; dashed line = median, above the dotted line = slow."
msgstr "Κλίμακα %s· διακεκομμένη γραμμή = διάμεσος, πάνω από τη διάστικτη = αργό."

msgid "of checks without a problem"
msgstr "των ελέγχων χωρίς πρόβλημα"

msgid "Each square is one hour; hover a day for what went wrong."
msgstr "Κάθε τετράγωνο είναι μία ώρα· περάστε το ποντίκι πάνω από μια μέρα για να δείτε τι χάλασε."

msgid "Order emails sent"
msgstr "Αποστολή email παραγγελιών"

msgid "No orders needing an email in the last 24 hours."
msgstr "Καμία παραγγελία που χρειάζεται email τις τελευταίες 24 ώρες."

msgid "%1$d of %2$d orders in the last 24 hours got no \"New order\" email. Check the site's mail and WP-Cron."
msgstr "%1$d από %2$d παραγγελίες των τελευταίων 24 ωρών δεν έστειλαν email «Νέα παραγγελία». Ελέγξτε το email του site και το WP-Cron."

msgid "%1$d of %2$d orders in the last 24 hours got no \"New order\" email."
msgstr "%1$d από %2$d παραγγελίες των τελευταίων 24 ωρών δεν έστειλαν email «Νέα παραγγελία»."

msgid "The %d order in the last 24 hours got its email."
msgid_plural "All %d orders in the last 24 hours got their email."
msgstr[0] "Η %d παραγγελία των τελευταίων 24 ωρών πήρε το email της."
msgstr[1] "Και οι %d παραγγελίες των τελευταίων 24 ωρών πήραν το email τους."

msgid "Object cache reachable"
msgstr "Object cache διαθέσιμο"

msgid "%s does not answer. Every page goes back to the database, and the store slows down under load. Ask your host."
msgstr "Το %s δεν απαντά. Κάθε σελίδα γυρίζει στη βάση δεδομένων και το κατάστημα αργεί όταν έχει κίνηση. Ρωτήστε τον πάροχο φιλοξενίας."

msgid "%s answers."
msgstr "Το %s απαντά."

msgid "No injected scripts"
msgstr "Χωρίς ενσωματωμένα κακόβουλα scripts"

msgid "Obfuscated script found, the way card skimmers hide: %s. Check it before the next order."
msgstr "Βρέθηκε συγκαλυμμένο script, όπως κρύβονται οι card skimmers: %s. Ελέγξτε το πριν την επόμενη παραγγελία."

msgid "Checked %d pages and settings that print scripts."
msgstr "Ελέγχθηκαν %d σελίδες και ρυθμίσεις που τυπώνουν scripts."

msgid "No PHP files in uploads"
msgstr "Χωρίς αρχεία PHP στα uploads"

msgid "%1$d PHP file in wp-content/uploads, where only media belong. Likely a web shell: %2$s."
msgid_plural "%1$d PHP files in wp-content/uploads, where only media belong. Likely a web shell: %2$s."
msgstr[0] "%1$d αρχείο PHP στο wp-content/uploads, όπου ανήκουν μόνο αρχεία πολυμέσων. Πιθανό web shell: %2$s."
msgstr[1] "%1$d αρχεία PHP στο wp-content/uploads, όπου ανήκουν μόνο αρχεία πολυμέσων. Πιθανό web shell: %2$s."

msgid "None found."
msgstr "Δεν βρέθηκε κανένα."

msgid "No administrator called \"admin\""
msgstr "Κανένας διαχειριστής με όνομα «admin»"

msgid "An administrator logs in as \"admin\", the first name bots try. Create a new administrator with another name and delete this one, giving its content to the new user."
msgstr "Ένας διαχειριστής συνδέεται ως «admin», το πρώτο όνομα που δοκιμάζουν τα bots. Δημιουργήστε νέο διαχειριστή με άλλο όνομα και διαγράψτε αυτόν, δίνοντας το περιεχόμενό του στον νέο χρήστη."

msgid "No administrator uses the default name."
msgstr "Κανένας διαχειριστής δεν χρησιμοποιεί το προεπιλεγμένο όνομα."

#. translators: %1$d: hours without an order, %2$s: orders usually taken in that time
msgid "No order for %1$d hours. At these hours of the week this store usually takes about %2$s orders."
msgstr "Καμία παραγγελία για %1$d ώρες. Αυτές τις ώρες της εβδομάδας το κατάστημα παίρνει συνήθως περίπου %2$s παραγγελίες."

msgid "A setting is wrong (fix it in the admin):"
msgstr "Μια ρύθμιση είναι λάθος (διορθώστε τη στη διαχείριση):"

msgid "The store is behaving differently than usual (look into it):"
msgstr "Το κατάστημα συμπεριφέρεται διαφορετικά από το συνηθισμένο (ελέγξτε το):"
